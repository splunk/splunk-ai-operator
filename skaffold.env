# Skaffold Environment Variables
# Copy this file and customize for your local development environment
#
# For public images, use the defaults below
# For private images, update with your registry URLs

RELATED_IMAGE_SPLUNK_ENTERPRISE=splunk/splunk:10.2.0
RELATED_IMAGE_WEAVIATE=semitechnologies/weaviate:stable-v1.28-007846a

# Ray images - Update these with your registry or use public alternatives
# Example: your-registry.io/ray/ray-head:2.44.0
RELATED_IMAGE_RAY_HEAD=${YOUR_REGISTRY:-rayproject}/ray:2.44.0-py310
RELATED_IMAGE_RAY_WORKER=${YOUR_REGISTRY:-rayproject}/ray:2.44.0-py310-gpu

# SAIA API - Update with your registry or build locally
# Example: your-registry.io/saia/api:latest
RELATED_IMAGE_SAIA_API=${YOUR_REGISTRY}/saia-api:latest
RELATED_IMAGE_POST_INSTALL_HOOK=${YOUR_REGISTRY}/saia-data-loader:latest

# OpenTelemetry Collector sidecar image - Update with your registry or use public alternatives
RELATED_IMAGE_OTEL_COLLECTOR=otel/opentelemetry-collector-contrib:0.122.1

# Optional: Cluster configuration
CLUSTER_NAME=${USER}-dev-cluster
MODEL_VERSION=v0.3.14-36-g1549f5a
RAY_VERSION=2.44.0